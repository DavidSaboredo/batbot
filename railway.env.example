# 🚀 Variables de Entorno para Railway - BatBot
# Copia este archivo y configura las variables en Railway Dashboard

# ============================================================================
# VARIABLES REQUERIDAS
# ============================================================================

# Token del Bot de Discord (OBLIGATORIO)
# Tu token específico (ya proporcionado por el usuario)
# ⚠️ IMPORTANTE: Solo configurar en Railway Variables, NUNCA en código público
DISCORD_TOKEN=a6f4daabb68963e6c7c65beca88dbd63070d56357918117a4937f8df4e8f3690

# Puerto para el servidor Flask (OPCIONAL)
# Railway asigna automáticamente, pero BatBot usa 8080 por defecto
PORT=8080

# ============================================================================
# VARIABLES OPCIONALES
# ============================================================================

# Prefijo para comandos del bot (por defecto: !)
BOT_PREFIX=!

# Modo debug (true/false)
DEBUG_MODE=false

# Nombre del bot (para logs)
BOT_NAME=BatCompany Discord Bot

# ============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (Si agregas una en el futuro)
# ============================================================================

# URL de base de datos (PostgreSQL, MySQL, etc.)
# DATABASE_URL=postgresql://usuario:password@host:puerto/database

# ============================================================================
# CONFIGURACIÓN DE LOGGING
# ============================================================================

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================================================
# CONFIGURACIÓN PERSONALIZADA
# ============================================================================

# Tiempo mínimo en canal para obtener primer rol (en minutos)
MIN_TIME_FOR_ROLE=5

# Intervalo de verificación de tiempo en canales (en segundos)
CHECK_INTERVAL=60

# ============================================================================
# INSTRUCCIONES DE USO
# ============================================================================

# 1. Ve a tu proyecto en Railway Dashboard
# 2. Clic en tu servicio → pestaña "Variables"
# 3. Clic "+ New Variable" para cada variable
# 4. Copia el nombre (Key) y valor (Value) de cada variable
# 5. NO incluyas el símbolo "=" ni comillas en Railway

# EJEMPLO en Railway:
# Key: DISCORD_TOKEN
# Value: MTIzNDU2Nzg5MDEyMzQ1Njc4OQ.GhIjKl.MnOpQrStUvWxYzAbCdEfGhIjKlMnOpQrStUv

# ⚠️  IMPORTANTE:
# - NUNCA subas este archivo con valores reales a GitHub
# - Usa solo variables de entorno en Railway
# - El archivo .gitignore ya excluye archivos .env

# 🔗 Enlaces útiles:
# Railway Dashboard: https://railway.app/dashboard
# Discord Developer Portal: https://discord.com/developers/applications
# Documentación Railway: https://docs.railway.app/deploy/variables